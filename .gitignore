# =========================================================================
# Snitch Git除外設定ファイル (.gitignore)
# 
# GitHubへ安全にコードを公開するため、個人情報や環境依存ファイルを管理から外します。
# =========================================================================

# --- 1. 個人情報・認証情報（最重要！） ---
# LINEのトークンやユーザーID、APIキーなどの機密情報が入っているため、絶対にGitHubに載せない
config.json
.env

# --- 2. Python仮想環境と実行用の環境 ---
# 各自のPC環境で再構築できるため、Git管理からは外す（requirements.txtから復元可能）
.venv/
venv/
ENV/

# --- 3. 一時データ・ログファイル ---
# スクレイピングで収集した一時データや、動作ログは公開しない
macbook_data.json
crawled_jobs.json
scrapebot_log.txt
snitch_log.txt
*.log

# --- 4. Pythonのコンパイルキャッシュ ---
# 実行時に自動生成される一時フォルダ
__pycache__/
*.py[cod]
*$py.class

# --- 5. OSの一時ファイル ---
# WindowsやMacが自動生成するフォルダ・システムファイル
.DS_Store
Thumbs.db
desktop.ini
